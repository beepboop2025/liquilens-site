{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liquilens-payments",
  "main": "edge/payments/worker.mjs",
  "compatibility_date": "2026-09-15",
  "workers_dev": false,
  "routes": [{"pattern": "payments.liquilens.in", "custom_domain": true}],
  "assets": {"directory": "edge/payments/public", "binding": "ASSETS", "run_worker_first": true},
  "durable_objects": {"bindings": [{"name": "PAYMENT_LEDGER", "class_name": "PaymentLedger"}]},
  "migrations": [{"tag": "payment-ledger-v1", "new_sqlite_classes": ["PaymentLedger"]}],
  "observability": {"enabled": false}
}
