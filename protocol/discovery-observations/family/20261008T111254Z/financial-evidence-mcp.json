{
  "initialize": {
    "result": {
      "protocolVersion": "2025-11-25",
      "capabilities": {
        "tools": {
          "listChanged": true
        }
      },
      "serverInfo": {
        "name": "financial-evidence",
        "version": "0.1.7"
      }
    },
    "jsonrpc": "2.0",
    "id": 1
  },
  "tools_list": {
    "result": {
      "tools": [
        {
          "name": "financial_evidence_topics",
          "title": "List Financial Evidence Topics",
          "description": "List supported topics and their fixed public raw-JSON routes without network access.",
          "inputSchema": {
            "type": "object",
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "properties": {},
            "additionalProperties": false
          },
          "annotations": {
            "readOnlyHint": true,
            "destructiveHint": false,
            "idempotentHint": true,
            "openWorldHint": false
          }
        },
        {
          "name": "financial_evidence_route",
          "title": "Route Financial Research",
          "description": "Resolve one or more financial research topics to fixed public raw-JSON sources without fetching them.",
          "inputSchema": {
            "type": "object",
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "properties": {
              "topics": {
                "minItems": 1,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "money-market",
                    "capital-market",
                    "china-economy",
                    "bank-risk",
                    "market-liquidity",
                    "gift-city",
                    "forex",
                    "gold"
                  ]
                },
                "uniqueItems": true
              }
            },
            "required": [
              "topics"
            ],
            "additionalProperties": false
          },
          "annotations": {
            "readOnlyHint": true,
            "destructiveHint": false,
            "idempotentHint": true,
            "openWorldHint": false
          }
        },
        {
          "name": "financial_evidence_fetch",
          "title": "Fetch Financial Evidence",
          "description": "Fetch bounded untrusted read-only JSON from fixed LiquiLens, Undertow, Seiche, and Palimpsest routes. Status reports transport only; evidence is not evaluated and Evidence Carrier verification is not performed.",
          "inputSchema": {
            "type": "object",
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "properties": {
              "topics": {
                "minItems": 1,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "money-market",
                    "capital-market",
                    "china-economy",
                    "bank-risk",
                    "market-liquidity",
                    "gift-city",
                    "forex",
                    "gold"
                  ]
                },
                "uniqueItems": true
              },
              "max_bytes": {
                "default": 1048576,
                "type": "integer",
                "minimum": 1,
                "maximum": 4194304
              },
              "timeout": {
                "default": 10,
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 30
              }
            },
            "required": [
              "topics"
            ],
            "additionalProperties": false
          },
          "annotations": {
            "readOnlyHint": true,
            "destructiveHint": false,
            "idempotentHint": true,
            "openWorldHint": true
          }
        }
      ]
    },
    "jsonrpc": "2.0",
    "id": 2
  },
  "scope": "anonymous_discovery_only_no_tools_called"
}
