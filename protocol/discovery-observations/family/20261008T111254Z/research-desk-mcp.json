                "default": "",
                "maxLength": 100,
                "title": "Bank",
                "type": "string"
              },
              "limit": {
                "default": 10,
                "maximum": 25,
                "minimum": 1,
                "title": "Limit",
                "type": "integer"
              },
              "previous_revision": {
                "default": "",
                "maxLength": 64,
