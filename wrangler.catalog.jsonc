{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liquilens-ai-catalog",
  "main": "edge/catalog-worker.mjs",
  "compatibility_date": "2026-08-06",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "https://liquilens.in/.well-known/api-catalog*",
      "zone_name": "liquilens.in"
    },
    {
      "pattern": "https://liquilens.in/.well-known/ai-catalog.json*",
      "zone_name": "liquilens.in"
    },
    {
      "pattern": "https://liquilens.in/.well-known/openai-apps-challenge*",
      "zone_name": "liquilens.in"
    },
    {
      "pattern": "https://liquilens.in/protocol/catalog.json*",
      "zone_name": "liquilens.in"
    },
    {
      "pattern": "https://liquilens.in/mcp/financial-evidence*",
      "zone_name": "liquilens.in"
    }
  ],
  "ratelimits": [
    {
      "name": "FINANCIAL_EVIDENCE_RATE_LIMITER",
      "namespace_id": "24082401",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true
  }
}
